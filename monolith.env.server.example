#############################################
# Monolith server runtime environment template
# Copy to /root/backend/.env and fill secrets
#############################################

# ---- Image / runtime ----
APP_IMAGE=ghcr.io/justblood/courses-monolith:dev-latest
SPRING_PROFILES_ACTIVE=pg,mail-smtp
APP_PORT=8080

# ---- Database ----
POSTGRES_DB=courses
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__SET_ME__
POSTGRES_PORT=5432

# ---- Security ----
APP_SECURITY_JWT_SECRET=__SET_ME__
APP_BOOTSTRAP_ADMIN_PASSWORD=__SET_ME__
APP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Mail ----
APP_MAIL_FROM=kirillporozoff@yandex.ru
APP_MAIL_INVITE_BASE_URL=http://localhost:8080
SPRING_MAIL_HOST=smtp.yandex.ru
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=kirillporozoff
SPRING_MAIL_PASSWORD=__SET_ME__
SPRING_MAIL_PROTOCOL=smtps
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true

# Optional (if used by app profile)
APP_SECURITY_JWT_EXPIRATION_MS=86400000
